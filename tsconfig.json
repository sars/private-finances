{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true,
    "noEmitOnError": true,
    "paths": {
      "@/*": ["./frontend/src/*"]
    }
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
