[Unit]
Description=Private Finances Telegram clarifications
After=network-online.target postgresql.service
Wants=network-online.target
# Five failed starts inside ten minutes means something is really wrong; stop
# retrying and stay failed rather than loop.
StartLimitIntervalSec=600
StartLimitBurst=5
ConditionPathExists=/etc/private-finances/telegram.enabled

[Service]
Type=simple
User=private-finances
Group=private-finances
WorkingDirectory=/opt/private-finances/current
EnvironmentFile=/etc/private-finances/app.env
EnvironmentFile=/etc/private-finances/telegram.env
ExecStart=/usr/bin/node dist/src/telegram-cli.js
# A crash leaves no half-sent message behind: a send in flight becomes
# 'uncertain' and is never repeated, and a classifier request in flight becomes
# 'uncertain' too. So restarting is safe, and without it one PostgreSQL restart
# silenced every question for the rest of the day (23 September 2026).
Restart=on-failure
RestartSec=30
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LimitNOFILE=4096
MemoryMax=512M

[Install]
WantedBy=multi-user.target
