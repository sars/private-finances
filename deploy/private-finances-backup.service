[Unit]
Description=Encrypted Private Finances database backup
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=private-finances
Group=private-finances
EnvironmentFile=/etc/private-finances/backup.env
ExecStart=/bin/bash /opt/private-finances/current/scripts/backup.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CacheDirectory=private-finances-restic
Environment=RESTIC_CACHE_DIR=/var/cache/private-finances-restic
TimeoutStartSec=1h
